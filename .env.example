# Copy this file to .env (untracked) and set real configuration values securely.
# NEVER commit secrets, production keys, or active environment files.
# All values below are placeholders or safe defaults.

# -----------------------------------------------------------------------------
# Application Core Settings
# -----------------------------------------------------------------------------
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8001
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:5173,http://localhost:5173

# API Authentication (Optional)
# If API_AUTH_REQUIRED=true, API_KEY must be provided or protected endpoints fail closed (HTTP 500).
API_KEY=
API_AUTH_REQUIRED=false

# -----------------------------------------------------------------------------
# Wazuh Manager API (Strict TLS Verification Required)
# -----------------------------------------------------------------------------
WAZUH_API_URL=https://127.0.0.1:55000
WAZUH_API_USERNAME=wazuh-api-user
WAZUH_API_PASSWORD=
WAZUH_CA_CERT_PATH=

# -----------------------------------------------------------------------------
# Wazuh Indexer / OpenSearch (Strict TLS Verification Required)
# -----------------------------------------------------------------------------
OPENSEARCH_URL=https://127.0.0.1:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=
OPENSEARCH_CA_CERT_PATH=
OPENSEARCH_ALERT_INDEX_PATTERN=wazuh-alerts-*

# -----------------------------------------------------------------------------
# Ollama Local AI Inference
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_MAX_CONCURRENCY=1

# -----------------------------------------------------------------------------
# Safety and Query Bounds
# -----------------------------------------------------------------------------
MAX_QUERY_WINDOW_HOURS=24
DEFAULT_QUERY_WINDOW_HOURS=1
MAX_SEARCH_RESULTS=100
MAX_EVIDENCE_EVENTS=50
MAX_EVIDENCE_BYTES=50000
ENABLE_DEMO_FIXTURES=false

# -----------------------------------------------------------------------------
# Relational Persistence & Audit Logging (SQLite WAL)
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///data/siem_history.db
DATABASE_ECHO=false
INVESTIGATION_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
AUDIT_ARCHIVE_DIR=data/archives
DATABASE_BACKUP_DIR=data/backups

# -----------------------------------------------------------------------------
# Database Backup & Cryptography (Windows DPAPI + AES-256-GCM)
# -----------------------------------------------------------------------------
BACKUP_ENCRYPTION_ENABLED=true
BACKUP_KEY_PATH=data/keys/backup_encryption_key.dpapi
# CRITICAL: Backup scheduling must remain disabled by default. Do not enable without authorization.
BACKUP_SCHEDULE_ENABLED=false
BACKUP_INTERVAL_MINUTES=1440
CHECKPOINT_SIGNING_ALGORITHM=NONE

# -----------------------------------------------------------------------------
# Notifications (Disabled by Default)
# -----------------------------------------------------------------------------
QUEUE_URL=
NOTIFICATIONS_ENABLED=false
TELEGRAM_ENABLED=false
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=

