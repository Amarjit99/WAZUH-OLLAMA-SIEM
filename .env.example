# Copy to a local untracked environment file and set real values securely.
# Never commit secrets. These are placeholders, not verified deployment URLs.

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Wazuh API
WAZUH_API_URL=https://wazuh-manager.example.invalid:55000
WAZUH_API_USERNAME=
WAZUH_API_PASSWORD=
WAZUH_CA_CERT_PATH=

# Wazuh Indexer / OpenSearch
OPENSEARCH_URL=https://wazuh-indexer.example.invalid:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_CA_CERT_PATH=
OPENSEARCH_ALERT_INDEX_PATTERN=

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=replace-with-installed-model
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_MAX_CONCURRENCY=1

# Safety and limits
MAX_QUERY_WINDOW_HOURS=24
MAX_SEARCH_RESULTS=100
MAX_EVIDENCE_EVENTS=50
MAX_EVIDENCE_BYTES=50000
ENABLE_DEMO_FIXTURES=false

# Optional application persistence / queue; enable only when implemented
DATABASE_URL=
QUEUE_URL=

# Notifications are disabled by default
NOTIFICATIONS_ENABLED=false
TELEGRAM_ENABLED=false
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
